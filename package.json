{
  "name": "hebbian-app-template",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Next.js 16 starter with @hebbian/dna branding wired.",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "release:check:security": "hebbian-dna-check-marketing-colors --roots app && hebbian-dna-egress-audit --include app --allowlist scripts/egress-allowlist.json",
    "test:e2e": "playwright test",
    "release:check": "npm run release:check:security && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@hebbian/dna": "github:mhellid-rgb/hebbian-dna#v0.1.3",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
